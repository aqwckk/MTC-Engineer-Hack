      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Записей в секунду, отправленных Fluentd",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 45
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (plugin_id) (rate(fluentd_output_status_emit_records[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{plugin_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
