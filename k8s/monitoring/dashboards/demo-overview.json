    },
    {
      "id": 16,
      "type": "logs",
      "title": "Access/error-логи приложения (Elasticsearch)",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 53
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "elasticsearch"
          },
          "query": "log_type:(access OR error)",
          "metrics": [
            {
              "type": "logs",
              "id": "1",
              "settings": {
                "limit": "200"
              }
            }
          ],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
